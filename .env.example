# Public host name served by Traefik, e.g. hydromiara.example.org
DOMAIN=
# Name of the Traefik entry point for HTTPS
TRAEFIK_ENTRYPOINT=
# Name of the Traefik certificate resolver
TRAEFIK_CERTRESOLVER=
# Optional: host directory with the drought indicator files (default ./data/edo)
EDO_DATA_PATH=
# Satellite scenes: which of the two interchangeable services is asked first
# (planetary-computer or earth-search) and which one replaces it (or: none).
SATELLITE_PRIMARY=planetary-computer
SATELLITE_SECONDARY=earth-search
# Seconds the primary service has to deliver a first reading before the
# secondary one is asked instead.
SATELLITE_FALLBACK_AFTER_S=4
# Optional: frontend image (default: placeholder nginx)
WEB_IMAGE=

# scripts/deploy.sh creates .env from this file and fills in the values below
# (it asks for them, or reads its options); see the README chapter on deployment.
# Public host name served by Traefik, e.g. hydromiara.example.org
DOMAIN=
# Name of the Traefik entry point for HTTPS (websecure with the Traefik from
# deploy/traefik/; on a server with its own Traefik: the name used there)
TRAEFIK_ENTRYPOINT=
# Name of the Traefik certificate resolver (le with the Traefik from deploy/traefik/)
TRAEFIK_CERTRESOLVER=
# Only for the Traefik started from deploy/traefik/docker-compose.yml: address of
# the Let's Encrypt account. Personal data: keep it only in .env. Not needed on a
# server that already runs Traefik.
ACME_EMAIL=
# Optional: host directory with the drought indicator files (default ./data/edo)
EDO_DATA_PATH=
# Satellite scenes: which of the two interchangeable services is asked first
# (planetary-computer or earth-search) and which one replaces it (or: none).
SATELLITE_PRIMARY=planetary-computer
SATELLITE_SECONDARY=earth-search
# Seconds the primary service has to deliver a first reading before the
# secondary one is asked instead.
SATELLITE_FALLBACK_AFTER_S=4
# Optional: short Report summary worded by a language model. Without a key or
# a model name every Report gets the summary made from a template.
# Key of the service (interface compatible with the OpenAI Chat Completions API).
# Secret: keep it only in .env, never in the repository or in a log.
AI_API_KEY=
# Name of the model as the service knows it; there is no default.
OPENAI_MODEL=
# Optional: base address of the service (default https://api.openai.com/v1).
AI_BASE_URL=
# Optional: longest wait for the model in seconds (default 12); the analysis
# never waits past its own 30-second budget.
AI_TIMEOUT_S=
# Optional: reasoning effort for models that accept it (none, minimal, low,
# medium, high, xhigh, max); not sent when empty.
AI_REASONING_EFFORT=
# Addresses of the reverse proxy, comma separated (an address or a network,
# e.g. the subnet of the Docker network "proxy": docker network inspect proxy).
# Only from these addresses the service believes the X-Forwarded-For header;
# without it every visitor counts as one client address for the request limits.
FORWARDED_ALLOW_IPS=
# Optional: 0 switches the request limits per client address off (default 1).
RATE_LIMIT_ENABLED=
# Optional: analyses running at the same time in the whole service (default 4;
# 0 = no limit).
MAX_CONCURRENT_ANALYSES=
# Optional: frontend image (default: placeholder nginx)
WEB_IMAGE=
